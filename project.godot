; Aisora — tested with Godot 4.6.3, Compatibility renderer.
config_version=5

[application]
config/name="Aisora"
run/main_scene="res://scenes/companion.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1120
window/size/window_height_override=700
window/size/mode=0
window/size/resizable=true
window/size/min_width=800
window/size/min_height=500
window/stretch/mode="canvas_items"

[audio]
driver/enable_input=false

[editor_plugins]
enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/vrm/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.08, 1)
